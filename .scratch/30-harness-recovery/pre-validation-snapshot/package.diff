+        acs=["result() returns 42"], interfaces=["pkg.calc.result() -> int"],
+        planned_tests=(DeclaredTestCase("AC-1", TEST_PATH, ("test_ac1_result",)),),
+        verification_reason="a returned-value assertion pins the goal",
+    )
