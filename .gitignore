.pi/
.pi-glla/
__pycache__/
*.pyc
.venv/
.untouched.baseline.json
# Run artifacts: the curated evidence directory is tracked; raw run output is not.
# Records (run.json / results.jsonl / *.log) stay on disk for inspection.
bench/runs/*
!bench/runs/evidence/
# Declared home for the wave-1 campaign archives. git cannot hold them; they are ignored here
# and verified by hash instead. Owner: this node. The file count, the byte count and the verify
# command live in AGENTS.md and bench/manifests/wave1.sha256 — not repeated here, so they cannot
# drift from the manifest.
bench/runs/wave1/

# Common local caches and temporary workspaces
node_modules/
.tmp/
worktrees/
